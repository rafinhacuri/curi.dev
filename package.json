{
  "name": "nuxt-app",
  "version": "3.1.1",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "nuxt build",
    "dev": "nuxt dev",
    "generate": "nuxt generate",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare",
    "fmt": "oxfmt --check",
    "fmt:fix": "oxfmt",
    "lint": "oxlint --type-aware",
    "lint:fix": "oxlint --type-aware --fix",
    "typecheck": "nuxi typecheck",
    "release": "bun run fmt && bun run lint && bun run typecheck && bumpp"
  },
  "dependencies": {
    "@iconify-json/devicon": "^1.2.62",
    "@iconify-json/fa-brands": "^1.2.2",
    "@iconify-json/ion": "^1.2.7",
    "@iconify-json/line-md": "^1.2.16",
    "@iconify-json/lucide": "^1.2.109",
    "@nuxt/image": "^2.0.0",
    "@nuxt/ui": "^4.8.0",
    "@nuxtjs/i18n": "10.4.0",
    "@nuxtjs/seo": "5.1.3",
    "@takumi-rs/core": "^1.5.1",
    "@vercel/analytics": "^2.0.1",
    "@vercel/speed-insights": "^2.0.0",
    "@vueuse/nuxt": "^14.3.0",
    "nuxt": "4.4.6",
    "nuxt-aos": "^1.2.6",
    "nuxt-security": "^2.6.0",
    "vue": "^3.5.34",
    "vue-router": "^5.0.7"
  },
  "devDependencies": {
    "@dethdkn/ox-config": "^1.0.22",
    "bumpp": "^11.1.0",
    "vue-tsc": "^3.3.2"
  },
  "packageManager": "bun@1.3.1",
  "trustedDependencies": [
    "@parcel/watcher",
    "@tailwindcss/oxide",
    "unrs-resolver"
  ]
}
