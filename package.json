{
  "name": "nuxt-app",
  "version": "4.0.3",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "nuxt build",
    "dev": "nuxt dev",
    "generate": "nuxt generate",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare",
    "fmt": "oxfmt --check",
    "fmt:fix": "oxfmt",
    "lint": "oxlint --type-aware",
    "lint:fix": "oxlint --type-aware --fix",
    "typecheck": "nuxi typecheck",
    "release": "bun run fmt && bun run lint && bun run typecheck && bumpp"
  },
  "dependencies": {
    "@iconify-json/devicon": "^1.2.62",
    "@iconify-json/fa-brands": "^1.2.2",
    "@iconify-json/ion": "^1.2.7",
    "@iconify-json/line-md": "^1.2.16",
    "@iconify-json/lucide": "^1.2.123",
    "@nuxt/image": "^2.1.0",
    "@nuxt/ui": "^4.10.0",
    "@nuxtjs/i18n": "10.6.0",
    "@nuxtjs/seo": "5.3.12",
    "@takumi-rs/core": "^2.9.0",
    "@vercel/analytics": "^2.0.1",
    "@vercel/speed-insights": "^2.0.0",
    "@vueuse/nuxt": "^14.4.0",
    "nuxt": "4.5.2",
    "nuxt-aos": "^1.2.6",
    "nuxt-security": "^2.6.0",
    "vue": "^3.5.41",
    "vue-router": "^5.2.0"
  },
  "devDependencies": {
    "@dethdkn/ox-config": "^1.0.23",
    "bumpp": "^12.2.1",
    "vue-tsc": "^3.3.9"
  },
  "overrides": {
    "@unhead/vue": "^3.3.2",
    "unhead": "^3.3.2"
  },
  "packageManager": "bun@1.3.1",
  "trustedDependencies": [
    "@parcel/watcher",
    "@tailwindcss/oxide",
    "unrs-resolver"
  ]
}
